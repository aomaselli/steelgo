# SteelGo — Required environment variables for Vercel deployment
# Copy this file to .env.local and fill in real values.

# ─── Supabase (browser-safe, VITE_ prefix exposes to client bundle) ───────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# ─── Supabase (server-only, never exposed to browser) ────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Identity & Driver Verification (server-only, NUNCA prefixo VITE_) ───────
# Modo dos providers: fake | sandbox | production
# fake e recusado em runtime de producao pela propria factory.
VERIFICATION_PROVIDER_MODE=
VERIFICATION_RULE_VERSION=

# GCC — Gestora de Consentimento Credenciada pela SENATRAN
GCC_BASE_URL=
GCC_CLIENT_ID=
GCC_CLIENT_SECRET=

# SERPRO Datavalid V5
DATAVALID_BASE_URL=
DATAVALID_CLIENT_ID=
DATAVALID_CLIENT_SECRET=
DATAVALID_RFB_TEMPLATE_ID=
DATAVALID_TIMEOUT_MS=

# Consulta Online SENATRAN (integracao distinta do Datavalid)
# O certificado ICP-Brasil vai em base64 na variavel; o .pfx NUNCA no repo.
SENATRAN_BASE_URL=
SENATRAN_CLIENT_ID=
SENATRAN_CLIENT_SECRET=
SENATRAN_CLIENT_CERT_P12_BASE64=
SENATRAN_CLIENT_CERT_PASSWORD=

# Pepper para HMAC de documentos (dedup sem guardar texto puro).
# SHA-256 puro de CPF e reversivel: 10^11 combinacoes.
IDENTITY_HASH_PEPPER=
